@{
    ViewData["Title"] = "Inicio";
}

<div class="container mt-5 home-hero">
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="display-4">
                BibliotecaMVC
            </h1>
            <p class="lead">
                Bienvenido a BibliotecaMVC, una biblioteca virtual diseñada para facilitar
                la consulta y gestión de libros, autores y categorías desde una plataforma
                sencilla y accesible.
            </p>
            <a asp-controller="Home" asp-action="AcercaDe" class="btn btn-primary">Conocer más</a>
        </div>
        <div class="col-md-6 text-center">
            <img src="~/images/biblioteca.jpg" alt="Biblioteca" class="img-fluid rounded shadow">
        </div>
    </div>
</div> 

<div class="container mt-5">
    <h2 class="text-center mb-4">Libros Destacados</h2>

    <div id="carouselLibros" class="carousel slide carousel-libros" data-bs-ride="carousel">

        <div class="carousel-indicators">
            <button type="button"
                    data-bs-target="#carouselLibros"
                    data-bs-slide-to="0"
                    class="active"
                    aria-current="true"
                    aria-label="Libro 1">
            </button>

            <button type="button"
                    data-bs-target="#carouselLibros"
                    data-bs-slide-to="1"
                    aria-label="Libro 2">
            </button>

            <button type="button"
                    data-bs-target="#carouselLibros"
                    data-bs-slide-to="2"
                    aria-label="Libro 3">
            </button>
        </div>

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="~/images/cien-anios.jpg"
                     class="d-block w-100"
                     alt="Cien años de soledad">

                <div class="carousel-caption">
                    <h5>Cien años de soledad</h5>
                    <p>Gabriel García Márquez</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/amor-tiempos-de-colera.jpg"
                     class="d-block w-100"
                     alt="El amor en los tiempos del cólera">

                <div class="carousel-caption">
                    <h5>El amor en los tiempos del cólera</h5>
                    <p>Gabriel García Márquez</p>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/rayuela.jpg"
                     class="d-block w-100"
                     alt="Rayuela">

                <div class="carousel-caption">
                    <h5>Rayuela</h5>
                    <p>Julio Cortázar</p>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselLibros"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"
                  aria-hidden="true"></span>

            <span class="visually-hidden">Anterior</span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carouselLibros"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"
                  aria-hidden="true"></span>

            <span class="visually-hidden">Siguiente</span>
        </button>

    </div>
</div>

<div class="container mt-5">
    <h2 class="text-center mb-4">Nuestros Servicios</h2>
    <div class="row">
       <div class="col-md-4 mb-3">
           <div class="card h-100 shadow-sm home-card">
                <img src="~/images/categorias.jpg" class="card-img-top" alt="Categorías">
                <div class="card-body d-flex flex-column">
                    <p class="card-text">Categorías de la biblioteca.</p>
                    <p class="card-text">Explora las diferentes categorías de libros disponibles en nuestra biblioteca.</p>
                    <a asp-controller="Home" asp-action="Categorias" class="btn btn-outline-primary mt-auto">Categorías de la biblioteca</a>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm home-card">
                <img src="~/images/libros.jpg" class="card-img-top" alt="Libros" style="height: 270px; object-fit: cover;
                                                      object-position: center bottom;">
                <div class="card-body d-flex flex-column">
                    <p class="card-text">Libros de la biblioteca.</p>
                    <p class="card-text">Explora nuestra amplia selección de libros disponibles en la biblioteca.</p>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-primary mt-auto">Libros de la biblioteca</a>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm home-card">
                <img src="~/images/autores.jpg" class="card-img-top" alt="Autores">
                <div class="card-body d-flex flex-column">
                    <p class="card-text">Autores de la biblioteca.</p>
                    <p class="card-text">Descubre los autores más destacados en nuestra biblioteca.</p>
                    <a asp-controller="Autores" asp-action="Index" class="btn btn-outline-primary mt-auto">Autores de la biblioteca</a>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="row text-center">
        <div class="col-md-4">
            <h2 class="text-primary">500+</h2>
            <p>Libros disponibles</p>
        </div>

        <div class="col-md-4">
            <h2 class="text-primary">120+</h2>
            <p>Autores registrados</p>
        </div>

        <div class="col-md-4">
            <h2 class="text-primary">25+</h2>
            <p>Categorías</p>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="bg-primary text-white rounded p-5 text-center">
        <h2>Explora nuestra biblioteca virtual</h2>
        <p class="lead">
            Explora nuestro catálogo digital, descubre nuevos autores y encuentra libros
            organizados por categorías desde cualquier dispositivo.
        </p>
        
        <a asp-controller="Home" asp-action="AcercaDe" class="btn btn-outline-light">Acerca de la biblioteca</a>
    </div>
</div>
