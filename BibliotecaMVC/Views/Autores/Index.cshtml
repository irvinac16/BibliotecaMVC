@model IEnumerable<BibliotecaMVC.Models.Autor>
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"] <small class="text-muted">(@Model.Count())</small></h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo Autor +</a>
</div>

<div class="row">
    @foreach (var autor in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card mb-4 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@autor.Nombre @autor.Apellido</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@autor.Nacionalidad</h6>
                    <p class="card-text mb-3">Edad: <strong>@(DateTime.Now.Year - autor.FechaNacimiento.Year)</strong></p>
                    
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <div>
                            <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@autor.Id">Ver</a>
                            <a class="btn btn-outline-secondary swal-edit-link" asp-action="Edit" asp-route-id="@autor.Id">Editar</a>
                        </div>
                        <form asp-action="Delete" asp-route-id="@autor.Id" method="post" class="d-inline swal-delete-form" data-tipo="autor">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>    