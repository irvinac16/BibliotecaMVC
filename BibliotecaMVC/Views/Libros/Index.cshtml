@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Catálogo de Libros</h2>
        <p class="text-muted mb-0">
            Explora los libros disponibles en nuestra biblioteca.
        </p>
    </div>

    <div class="d-flex gap-2 flex-wrap">

        <a class="btn btn-outline-primary" asp-route-autor="@ViewBag.AutorSeleccionado" asp-route-categoria="@ViewBag.CategoriaSeleccionada" asp-controller="Reportes" asp-action="Reporte" target="_blank" rel="noopener"><i class="bi bi-eye"></i>
            Generar Reporte
        </a>

        <a class="btn btn-outline-danger" asp-route-autor="@ViewBag.AutorSeleccionado" asp-route-categoria="@ViewBag.CategoriaSeleccionada" asp-controller="Reportes" asp-action="DescargarPDF">
            <i class="bi bi-file-earmark-pdf"></i>
            Descargar Reporte
        </a>
        
        <a class="btn btn-outline-success" asp-route-autor="@ViewBag.AutorSeleccionado" asp-route-categoria="@ViewBag.CategoriaSeleccionada" asp-controller="Reportes" asp-action="ExportarExcel">
            <i class="bi bi-file-earmark-excel"></i>
            Exportar a Excel
        </a>

        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
        {
            <a class="btn btn-primary" asp-action="Create">
                + Nuevo Libro
            </a>
        }

    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-controller="Libros" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Filtrar por autor</label>

                    <select name="autor" class="form-select">
                        <option value="">Todos los autores</option>

                        @foreach (var autor in ViewBag.Autores)
                        {
                            <option value="@autor" selected="@(ViewBag.AutorSeleccionado == autor)">@autor</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Filtrar por categoría</label>

                    <select name="categoria" class="form-select">
                        <option value="">Todas las categorías</option>

                        @foreach (var categoria in ViewBag.Categorias)
                        {
                            <option value="@categoria" selected="@(ViewBag.CategoriaSeleccionada == categoria)">@categoria</option>
                        }
                    </select>
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i>Filtrar</button>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-outline-secondary">Limpiar filtros</a>
                </div>
            </div>
        </form>
    </div>
</div>


<div class="row g-4">
    @foreach (var libro in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm border-0">

                <img src="~/images/@libro.Imagen"
                     class="card-img-top"
                     alt="@libro.Titulo"
                     style="height:300px; object-fit:cover;" />

                <div class="card-body d-flex flex-column">

                    <h5 class="card-title fw-bold">@libro.Titulo</h5>

                    <p class="text-muted mb-2">
                        <strong>Autor:</strong> @libro.Autor
                    </p>

                    <p class="text-muted mb-2">
                        <strong>Categoría:</strong> @libro.Categoria
                    </p>

                    <p class="fs-5 fw-bold mb-3">
                        $@libro.Precio.ToString("0.00")
                    </p>

                    <div class="mb-3">
                        @if (libro.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Prestado</span>
                        }
                    </div>

                    <div class="mt-auto d-flex gap-2 flex-wrap">
                        <a asp-action="Details" asp-route-id="@libro.Id" class="btn btn-outline-primary">Ver</a>

                        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                        {
                            <a asp-action="Edit" asp-route-id="@libro.Id" class="btn btn-outline-secondary">Editar</a>

                            <form asp-action="Delete"
                                  asp-route-id="@libro.Id"
                                  method="post"
                                  class="d-inline swal-delete-form"
                                  data-tipo="libro">

                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-danger">Eliminar</button>
                            </form>
                        }
                    </div>

                </div>
            </div>
        </div>
    }
</div>
