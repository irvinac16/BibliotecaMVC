@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Crear Libro";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="mb-4">
                    <h2 class="fw-bold mb-1">Agregar un nuevo libro</h2>
                    <p class="text-muted mb-0">
                        Complete la información del libro para agregarlo al catálogo.
                    </p>
                </div>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="Titulo" class="form-label fw-semibold">
                                Título
                            </label>
                            <input asp-for="Titulo"
                                   class="form-control"
                                   placeholder="Ingrese el título del libro" />
                            <span asp-validation-for="Titulo"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Autor" class="form-label fw-semibold">
                                Autor
                            </label>
                            <input asp-for="Autor"
                                   class="form-control"
                                   placeholder="Ingrese el autor" />
                            <span asp-validation-for="Autor"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Categoria" class="form-label fw-semibold">
                                Categoría
                            </label>
                            <input asp-for="Categoria"
                                   class="form-control"
                                   placeholder="Ingrese la categoría" />
                            <span asp-validation-for="Categoria"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Precio" class="form-label fw-semibold">
                                Precio
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Precio"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Precio"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Imagen" class="form-label fw-semibold">
                                Imagen
                            </label>
                            <input asp-for="Imagen"
                                   class="form-control"
                                   placeholder="ejemplo.jpg" />
                            <span asp-validation-for="Imagen"
                                  class="text-danger">
                            </span>
                            <small class="text-muted">
                                Escriba el nombre del archivo ubicado en wwwroot/images.
                            </small>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Disponible"
                                       class="form-check-input" />
                                <label asp-for="Disponible"
                                       class="form-check-label">
                                    Libro disponible
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar libro
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}